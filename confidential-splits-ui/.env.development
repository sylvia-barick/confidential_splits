# Loaded automatically by `npm run dev` (vite, mode=development).
# The build/preview paths get the same values from .env.preprod / .env.preview.
VITE_NETWORK_ID=preprod
VITE_LOGGING_LEVEL=trace
# Local ZK proof server: docker compose -f confidential-splits-cli/proof-server-local.yml up -d
# Overrides the prover URI advertised by the 1AM wallet, whose hosted prover
# (https://api-preprod.1am.xyz) can return HTTP 500 on /check for this contract's circuits.
